{
  "name": "@gang-of-beads/pi-web-themes",
  "version": "0.1.0",
  "description": "Theme pack plugin for PI WEB: theme token packs contributed through the plugin contract.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-web",
    "pi-web-plugin",
    "themes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gang-of-Beads/pi-web-themes.git"
  },
  "bugs": {
    "url": "https://github.com/Gang-of-Beads/pi-web-themes/issues"
  },
  "homepage": "https://github.com/Gang-of-Beads/pi-web-themes#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "pi-web-plugin.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "piWeb": {
    "plugins": [
      {
        "id": "themes",
        "browserRoot": ".",
        "module": "pi-web-plugin.js",
        "title": "Themes"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code -- pi-web-plugin.js"
  },
  "devDependencies": {
    "@gang-of-beads/pi-web-plugin-api": "^0.1.0-alpha.2",
    "esbuild": "^0.28.2",
    "lit": "^3.3.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
